# Environment Configuration for Road Quality Map POC

# Google Street View Static API Key (Optional for live Tier 0 calls)
# Obtain from: https://console.cloud.google.com/google/maps-apis/credentials
# Leave empty or default to use built-in baseline simulation mode.
GOOGLE_STREET_VIEW_API_KEY=YOUR_GOOGLE_STREET_VIEW_API_KEY

# Bounding Box Coordinates (Bengaluru Outer Ring Road - Marathahalli to Silk Board segment)
MIN_LAT=12.925
MAX_LAT=12.945
MIN_LON=77.660
MAX_LON=77.700

# Staleness Exponential Decay Rate (Per day)
# Higher values cause older observations to fade faster
DECAY_RATE=0.035

# Server Port
PORT=8000
HOST=127.0.0.1
